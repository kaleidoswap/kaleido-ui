# The lockfile is resolved without auto-installed peers. react-native is an
# optional peer of this package but a required one of
# @tetherto/wdk-uikit-react-native, so npm 7+'s default peer resolution pulls
# react-native (and ~200 transitive packages) into a tree the lockfile does not
# describe, and `npm ci` refuses to install. This keeps `npm ci` and
# `npm install` on the same tree the lockfile pins. Not published: npm never
# packs .npmrc.
legacy-peer-deps=true
