{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // The built package's own types, as an app installing it sees them.
    "paths": {
      "kaleido-ui": ["../dist/web/index.d.ts"],
      "kaleido-ui/icons": ["../dist/web/icons.d.ts"],
      "kaleido-ui/tokens": ["../dist/tokens/index.d.ts"]
    }
  },
  "include": ["src"]
}
